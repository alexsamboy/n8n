ADS_PLACEMENT_FIELD=
ADS_PRIORITY_FIELD=
ADS_ACTIVE_FROM_FIELD=newsletter.inicio
ADS_ACTIVE_UNTIL_FIELD=newsletter.fin

# Catálogo histórico de configuración no secreta. La edición comunitaria actual
