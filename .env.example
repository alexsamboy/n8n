# Imagen y zona horaria
N8N_VERSION=2.35.5
GENERIC_TIMEZONE=America/Santo_Domingo
TZ=America/Santo_Domingo
DIGEST_SEND_HOUR=08
DIGEST_SEND_MINUTE=00

# WordPress. Las lecturas GraphQL actualmente funcionan sin autenticación.
WP_BASE_URL=https://dia.pucmm.edu.do
WP_REST_INDEX_URL=https://dia.pucmm.edu.do/wp-json/
WP_REST_API_BASE=https://dia.pucmm.edu.do/wp-json/wp/v2
