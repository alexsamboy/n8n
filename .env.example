EMAIL_FROM=comunicaciones@pucmm.edu.do
EMAIL_FROM_NAME=Comunicaciones PUCMM
EMAIL_TO_DAILY=comunidad@pucmm.edu.do,st-estudiante@ce.pucmm.edu.do,sd-estudiante@ce.pucmm.edu.do
