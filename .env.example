WP_API_MODE=graphql
WP_EVENTS_POST_TYPE=
WP_EVENTS_REST_ROUTE=
WP_EVENTS_GRAPHQL_QUERY_FILE=
WP_ADS_POST_TYPE=
WP_ADS_REST_ROUTE=
WP_ADS_GRAPHQL_QUERY_FILE=
WP_AUTH_MODE=public
WP_USERNAME=
WP_APPLICATION_PASSWORD=
WP_REQUEST_TIMEOUT_MS=30000
WP_PAGE_SIZE=100
WP_MAX_PAGES=100
EVENT_START_FIELD=horaYFechaDelEvento.fechaInicio
EVENT_END_FIELD=horaYFechaDelEvento.fechaTermino
EVENT_VENUE_FIELD=locations.nodes.0.name
EVENT_CAMPUS_FIELD=detallesDelEvento.detcampus
EVENT_MODALITY_FIELD=detallesDelEvento.modalidad
