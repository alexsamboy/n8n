    {
      "id": "0e2a1438a7325022",
      "name": "Preparar consultas GraphQL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
        0
      ],
      "parameters": {
        "jsCode": "const c=$json;const local=s=>{const d=new Date(s);const p=Object.fromEntries(new Intl.DateTimeFormat('en-CA',{timeZone:'America/Santo_Domingo',year:'numeric',month:'numeric',day:'numeric'}).formatToParts(d).map(x=>[x.type,x.value]));return {year:+p.year,month:+p.month,day:+p.day};};const query='query Press($first:Int!,$cursor:String,$after:DateInput,$before:DateInput){posts(first:$first,after:$cursor,where:{dateQuery:{after:$after,before:$before,inclusive:true}}){nodes{databaseId title date link content featuredImage{node{sourceUrl altText mediaDetails{width height}}}categories{nodes{databaseId name slug}}opcionesPublicacion{portalPucmm campus dependencia{nodes{databaseId name slug}}}}pageInfo{hasNextPage endCursor}}}';const banners='query Banners($first:Int!,$cursor:String){banners(first:$first,after:$cursor,where:{status:PUBLISH}){nodes{databaseId title status newsletter{inicio fin enlace}featuredImage{node{sourceUrl altText mediaDetails{width height}}}}pageInfo{hasNextPage endCursor}}}';return [{json:{...c,pressBody:{query,variables:{first:c.wpPageSize,cursor:null,after:local(c.windowStart),before:local(c.windowEndExclusive)}},bannerBody:{query:banners,variables:{first:c.wpPageSize,cursor:null}}}}];"
      }
    },
