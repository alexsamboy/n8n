    {
      "id": "6d361514d86edafb",
      "name": "Normalizar y construir MJML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ],
      "parameters": {
        "jsCode": "const crypto=require('crypto');const cfg=$('Configuración segura').first().json;const pages=name=>$(name).all().flatMap(i=>Array.isArray(i.json)?i.json:[i.json]);if(cfg.developmentMode!==true||cfg.testMode!==true)throw new Error('Prensa solo permite envíos de desarrollo a destinatarios de prueba');const pp=pages('Consultar Prensa paginada');const bp=pages('Consultar banners paginados');if(pp.some(x=>x.errors?.length)||bp.some(x=>x.errors?.length))throw new Error('GraphQL errors[]');const clean=v=>String(v??'').replace(/<script\\b[^>]*>[\\s\\S]*?<\\/script>/gi,' ').replace(/<style\\b[^>]*>[\\s\\S]*?<\\/style>/gi,' ').replace(/<[^>]+>/g,' ').replace(/&amp;/gi,'&').replace(/&nbsp;/gi,' ').replace(/\\s+/g,' ').trim();const esc=v=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));const safe=(v,h)=>{const s=String(v||'').trim();if(!/^https:\\/\\/[^\\s<>\\x22\\x27]+$/i.test(s))return null;if(!h)return s;const prefix='https://'+h;return s===prefix||s.startsWith(prefix+'/')||s.startsWith(prefix+'?')||s.startsWith(prefix+'#')?s:null};const iso=v=>{const s=String(v||'');return /[zZ]|[+-]\\d\\d:\\d\\d$/.test(s)?new Date(s):new Date(s+'-04:00')};const raw=pp.flatMap(x=>x.data?.posts?.nodes||[]),invalid=[];const map=new Map();for(const x of raw){const dep=clean(x.opcionesPublicacion?.dependencia?.nodes?.[0]?.name);const d=iso(x.date);const a={id:String(x.databaseId||''),title:clean(x.title),publishedAt:d.toISOString(),url:safe(x.link,'prensa.pucmm.edu.do'),excerptText:clean(x.content).slice(0,cfg.excerptMaxChars),imageUrl:safe(x.featuredImage?.node?.sourceUrl,'prensa.pucmm.edu.do'),imageAlt:clean(x.featuredImage?.node?.altText)||clean(x.title),categories:(x.categories?.nodes||[]).map(y=>({id:String(y.databaseId||''),name:clean(y.name),slug:clean(y.slug)})),campus:clean(x.opcionesPublicacion?.campus)||null,department:dep||null,portalPucmm:Boolean(x.opcionesPublicacion?.portalPucmm),segment:dep.normalize('NFD').replace(/[\\u0300-\\u036f]/g,'').toLowerCase()==='rectoria'?0:x.opcionesPublicacion?.portalPucmm?1:2};if(!a.id||!a.title||!a.url||Number.isNaN(d.valueOf())||d<new Date(cfg.windowStart)||d>=new Date(cfg.windowEndExclusive)){invalid.push(a.id);continue}if(!map.has(a.id))map.set(a.id,a)}const articles=[...map.values()].sort((a,b)=>a.segment-b.segment||b.publishedAt.localeCompare(a.publishedAt)||a.id.localeCompare(b.id));const now=new Date(cfg.referenceNow);const ads=bp.flatMap(x=>x.data?.banners?.nodes||[]).map(x=>({id:String(x.databaseId||''),title:clean(x.title),imageUrl:safe(x.featuredImage?.node?.sourceUrl,'dia.pucmm.edu.do'),imageAlt:clean(x.featuredImage?.node?.altText)||clean(x.title),targetUrl:safe(x.newsletter?.enlace),activeFrom:x.newsletter?.inicio,activeUntil:x.newsletter?.fin,priority:(()=>{const n=Number(x.priority??x.prioridad??x.newsletter?.priority??x.newsletter?.prioridad);return Number.isFinite(n)?n:0})()})).filter(x=>x.id&&x.imageUrl&&x.targetUrl&&(!x.activeFrom||new Date(x.activeFrom)<=now)&&(!x.activeUntil||now<new Date(x.activeUntil))).sort((a,b)=>b.priority-a.priority||String(b.activeFrom||'').localeCompare(String(a.activeFrom||''))||a.id.localeCompare(b.id)).slice(0,2);const blocks=[];articles.forEach((a,i)=>{const date=new Intl.DateTimeFormat('es-DO',{timeZone:'America/Santo_Domingo',dateStyle:'long'}).format(new Date(a.publishedAt));blocks.push('<mj-section background-color=\"#fff\" padding=\"18px 28px\"><mj-column>'+(a.imageUrl?'<mj-image href=\"'+esc(a.url)+'\" src=\"'+esc(a.imageUrl)+'\" alt=\"'+esc(a.imageAlt)+'\" padding=\"0 0 16px\"/>':'')+'<mj-text font-size=\"12px\" color=\"#666\">'+esc((a.categories[0]?.name?a.categories[0].name+' · ':'')+date)+'</mj-text><mj-text font-family=\"Libre Baskerville,Georgia,serif\" font-size=\"21px\"><a href=\"'+esc(a.url)+'\" style=\"color:#111;text-decoration:none\"><b>'+esc(a.title)+'</b></a></mj-text><mj-text>'+esc(a.excerptText)+'</mj-text><mj-text><a href=\"'+esc(a.url)+'\" style=\"color:#00369c\"><b>Leer noticia</b></a></mj-text><mj-divider border-color=\"#ddd\"/></mj-column></mj-section>');const ad=i===0?ads[0]:i===2?ads[1]:i===articles.length-1&&articles.length<3?ads[1]:null;if(ad)blocks.push('<mj-section background-color=\"#fff\" padding=\"8px 28px\"><mj-column><mj-image href=\"'+esc(ad.targetUrl)+'\" src=\"'+esc(ad.imageUrl)+'\" alt=\"'+esc(ad.imageAlt)+'\"/></mj-column></mj-section>')});const key=crypto.createHash('sha256').update('internal-press|'+cfg.windowStart+'|'+cfg.windowEndExclusive+'|'+cfg.recipientGroup).digest('hex');const subject=(cfg.testMode?'[PRUEBA] ':'')+'Boletín Interno Prensa';const test=cfg.testMode?'<mj-section background-color=\"#fff4b8\"><mj-column><mj-text align=\"center\"><b>[PRUEBA]</b> '+esc(cfg.windowStart)+' → '+esc(cfg.windowEndExclusive)+' · '+key.slice(0,12)+'</mj-text></mj-column></mj-section>':'';const mjml='<mjml><mj-head><mj-title>'+subject+'</mj-title><mj-preview>'+articles.length+' noticias de Prensa PUCMM</mj-preview><mj-breakpoint width=\"575px\"/><mj-font name=\"Libre Baskerville\" href=\"https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&amp;display=swap\"/></mj-head><mj-body width=\"800px\" background-color=\"#f1f1f1\">'+test+'<mj-section background-color=\"#00369c\"><mj-column width=\"30%\"><mj-image src=\"'+esc(cfg.logoUrl)+'\" alt=\"PUCMM\"/></mj-column><mj-column width=\"70%\"><mj-text align=\"center\" color=\"#fff\"><h1>Prensa PUCMM</h1><p>Boletín Informativo · Dirección de Comunicaciones</p></mj-text></mj-column></mj-section><mj-section background-color=\"#F4D500\" padding=\"3px\"><mj-column><mj-spacer height=\"1px\"/></mj-column></mj-section>'+blocks.join('')+'<mj-section background-color=\"#fff\"><mj-column><mj-button background-color=\"#F4D500\" color=\"#111\" href=\"'+esc(cfg.pressUrl)+'\">Ver todas las noticias</mj-button></mj-column></mj-section></mj-body></mjml>';const recipients=cfg.testMode?cfg.emailTestRecipients:cfg.emailTo;if(cfg.testMode&&!recipients)throw new Error('TEST_MODE requiere destinatario');return [{json:{...cfg,articles,banners:ads,activityCount:articles.length,articleCount:articles.length,adCount:ads.length,invalidCount:invalid.length,executionKey:key,subject,mjml,recipients,shouldSend:articles.length>0,startedAt:new Date().toISOString()}}];"
      }
    },
