        "jsCode": "const zone='America/Santo_Domingo';const manual=$execution.mode==='manual'&&!$json.referenceNow&&!$json.windowStart&&!$json.windowEndExclusive;const testNow='2026-08-20T23:00:00-04:00';const testStart='2026-08-19T00:00:00-04:00';const testEnd='2026-08-20T00:00:00-04:00';const now=manual?new Date(testNow):$json.referenceNow?new Date($json.referenceNow):new Date();if(Number.isNaN(now.valueOf()))throw new Error('referenceNow inválido');const dow=Number(new Intl.DateTimeFormat('en-US',{timeZone:zone,weekday:'short'}).format(now)==='Mon'?1:2);const hours=dow===1?72:24;const saved=$json.window_end&&$json.status==='sent'?$json.window_end:null;const start=manual?new Date(testStart):$json.windowStart?new Date($json.windowStart):saved?new Date(saved):new Date(now.valueOf()-hours*3600000);const end=manual?new Date(testEnd):$json.windowEndExclusive?new Date($json.windowEndExclusive):now;if(Number.isNaN(start.valueOf())||start>=end)throw new Error('Ventana inválida');return [{json:{referenceNow:now.toISOString(),windowStart:start.toISOString(),windowEndExclusive:end.toISOString(),recipientGroup:'internal-community',digestType:'daily',emailTransport:'smtp',testMode:manual,forceResend:manual,windowSource:manual?'fixed_test_2026-08-19':saved?'last_success':'fallback'}}];"
