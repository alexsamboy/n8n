        "jsCode": "const input=$json||{};const reference=input.referenceNow||input.referenceDate||new Date().toISOString();const n=new Date(reference);if(Number.isNaN(n.getTime()))throw new Error('referenceNow inválido');const p=Object.fromEntries(new Intl.DateTimeFormat('en-US',{timeZone:'America/Santo_Domingo',year:'numeric',month:'numeric'}).formatToParts(n).map(x=>[x.type,x.value]));const y=Number(p.year),m=Number(p.month);const offset=4;return [{json:{...input,referenceNow:n.toISOString(),windowStart:new Date(Date.UTC(y,m-2,1,offset)).toISOString(),windowEndExclusive:new Date(Date.UTC(y,m-1,1,offset)).toISOString(),recipientGroup:'allies-monthly',dryRun:input.dryRun!==false}}];"
