      "id": "0e2a1438a7325022",
      "name": "Preparar consulta mensual",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -700,
        0
      ],
      "parameters": {
        "jsCode": "const c=$json;const local=s=>{const d=new Date(s),p=Object.fromEntries(new Intl.DateTimeFormat('en-CA',{timeZone:'America/Santo_Domingo',year:'numeric',month:'numeric',day:'numeric'}).formatToParts(d).map(x=>[x.type,x.value]));return {year:+p.year,month:+p.month,day:+p.day}};const query='query PressMonthly($first:Int!,$cursor:String,$after:DateInput,$before:DateInput){posts(first:$first,after:$cursor,where:{dateQuery:{after:$after,before:$before,inclusive:true}}){nodes{databaseId title date link content featuredImage{node{sourceUrl altText}} categories{nodes{databaseId name slug}} opcionesPublicacion{portalPucmm campus dependencia{nodes{databaseId name slug}}}} pageInfo{hasNextPage endCursor}}}';return [{json:{...c,pressBody:{query,variables:{first:c.wpPageSize,cursor:null,after:local(c.windowStart),before:local(c.windowEndExclusive)}}}}];"
      }
    },
    {
      "id": "673bdd124143f848",
      "name": "Consultar Prensa mensual",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        -500,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuración Aliados').first().json.pressGraphqlUrl }}",
        "authentication": "genericCredentialType",
