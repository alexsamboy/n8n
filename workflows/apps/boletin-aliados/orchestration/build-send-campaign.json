        "options": {
          "pagination": {
            "pagination": {
              "parameters": {
                "parameters": [
                  {
                    "type": "body",
                    "name": "variables.cursor",
                    "value": "={{ $response.body.data.posts.pageInfo.endCursor }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.data.posts.pageInfo.hasNextPage }}",
              "limitPagesFetched": true,
              "maxRequests": 100,
              "requestInterval": 250
            }
          },
          "timeout": 30000
        }
      },
      "credentials": {
        "httpBasicAuth": {
          "id": "GbAhTYn0osJtfFWq",
