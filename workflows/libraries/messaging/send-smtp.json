        "subject": "={{ $json.subject }}",
        "emailFormat": "html",
        "html": "={{ $json.html }}",
        "options": {
          "replyTo": "={{ $json.replyTo }}",
          "appendAttribution": false
        }
      },
      "webhookId": "2d11ffaa-a2cf-409c-90cb-b43ef0b333bf",
      "credentials": {
        "smtp": {
          "id": "pucmm-agenda-smtp",
          "name": "PUCMM Agenda SMTP"
        }
      }
    },
    {
      "id": "361e2ac9-9c01-4273-b975-f90c123e1126",
      "name": "Registrar envío SMTP",
      "type": "n8n-nodes-base.dataTable",
