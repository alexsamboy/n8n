          "value": {
            "execution_key": "={{ $('Validar entrada SMTP').item.json.idempotencyKey }}",
            "digest_type": "={{ $('Validar entrada SMTP').item.json.digestType }}",
            "window_start": "={{ $('Validar entrada SMTP').item.json.windowStart }}",
            "window_end": "={{ $('Validar entrada SMTP').item.json.windowEndExclusive }}",
            "recipient_group": "={{ $('Validar entrada SMTP').item.json.recipientGroup }}",
            "status": "sent",
            "message_id": "={{ $json.id || $json.messageId || \"\" }}",
            "sent_at": "={{ $now.toISO() }}",
            "activity_count": "={{ $('Validar entrada SMTP').item.json.activityCount }}",
            "ad_count": "={{ $('Validar entrada SMTP').item.json.adCount }}"
          },
          "matchingColumns": [],
