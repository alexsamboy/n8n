    {
      "id": "6f7cdb22-31c5-4e1e-ba55-d89dbe743177",
      "name": "Validar entrada SMTP",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const x=$json;if(Number(x.contractVersion)!==1)throw new Error('contractVersion SMTP no soportada');for(const f of ['fromEmail','fromName','replyTo','toEmail','subject','html','dataTableId','idempotencyKey','recipientGroup','digestType','windowStart','windowEndExclusive'])if(typeof x[f]!=='string'||!x[f].trim())throw new Error('SMTP requiere '+f);const email=/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;if(!email.test(x.fromEmail.trim())||!email.test(x.replyTo.trim()))throw new Error('Remitente o replyTo SMTP inválido');const recipients=[...new Set(x.toEmail.split(/[;,]/).map(v=>v.trim()).filter(Boolean))];if(!recipients.length||recipients.some(v=>!email.test(v)))throw new Error('Destinatarios SMTP inválidos');const allowed=[...new Set((Array.isArray(x.allowedDomains)?x.allowedDomains:[]).map(v=>String(v).trim().toLowerCase()).filter(Boolean))];if(allowed.length&&recipients.some(v=>!allowed.includes(v.split('@')[1].toLowerCase())))throw new Error('Destinatario SMTP fuera de dominios permitidos');if(!x.html.toLowerCase().includes('<html'))throw new Error('SMTP requiere HTML compilado');const startedAt=typeof x.startedAt==='string'&&!Number.isNaN(new Date(x.startedAt).valueOf())?x.startedAt:new Date().toISOString();return [{json:{...x,contractVersion:1,testMode:Boolean(x.testMode),fromEmail:x.fromEmail.trim(),fromName:x.fromName.trim(),replyTo:x.replyTo.trim(),toEmail:recipients.join(','),allowedDomains:allowed,subject:x.subject.trim(),dataTableId:x.dataTableId.trim(),idempotencyKey:x.idempotencyKey.trim(),recipientGroup:x.recipientGroup.trim(),digestType:x.digestType.trim(),activityCount:Number(x.activityCount)||0,adCount:Number(x.adCount)||0,invalidCount:Number(x.invalidCount)||0,recipientCount:recipients.length,startedAt}}];"
      }
    },
    {
      "id": "07b4a383-ef55-42ae-bc20-a3de7b623fac",
      "name": "Verificar idempotencia SMTP",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        448,
        0
      ],
      "parameters": {
        "resource": "row",
        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.dataTableId }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "execution_key",
              "condition": "eq",
              "keyValue": "={{ $json.idempotencyKey }}"
            }
          ]
        }
      }
    },
