        "language": "javaScript",
        "jsCode": "const s=$('Validar entrada SMTP').item.json;return [{json:{contractVersion:1,status:'sent',transport:'smtp',digestType:s.digestType,windowStart:s.windowStart,windowEndExclusive:s.windowEndExclusive,activityCount:s.activityCount,adCount:s.adCount,invalidCount:s.invalidCount,recipientCount:s.recipientCount,messageId:$json.message_id||null,durationMs:Date.now()-new Date(s.startedAt).valueOf(),idempotencyKey:s.idempotencyKey}}];"
      }
    }
