        "specifyBody": "json",
        "jsonBody": "={{ ({ name: $('Validar entrada Brevo').item.json.name, tag: $('Validar entrada Brevo').item.json.tag, subject: $('Validar entrada Brevo').item.json.subject, sender: { id: $('Validar entrada Brevo').item.json.senderId }, replyTo: $('Validar entrada Brevo').item.json.replyTo, recipients: { listIds: $('Validar entrada Brevo').item.json.listIds }, htmlContent: $('Validar entrada Brevo').item.json.html }) }}",
        "options": {
          "response": {
