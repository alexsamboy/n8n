    {
      "id": "c57aa55b-fdaf-4616-8cdc-effbc9076f84",
      "name": "Validar entrada Brevo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const x=$json;if(Number(x.contractVersion)!==1)throw new Error('contractVersion Brevo no soportada');for(const f of ['name','tag','subject','html','replyTo','dataTableId','idempotencyKey','recipientGroup','digestType','windowStart','windowEndExclusive'])if(typeof x[f]!=='string'||!x[f].trim())throw new Error('Brevo requiere '+f);if(!x.html.toLowerCase().includes('<html'))throw new Error('Brevo requiere HTML compilado');const senderId=Number(x.senderId);if(!Number.isInteger(senderId)||senderId<1)throw new Error('senderId Brevo inválido');const listIds=[...new Set((Array.isArray(x.listIds)?x.listIds:[]).map(Number))];if(!listIds.length||listIds.some(id=>!Number.isInteger(id)||id<1))throw new Error('listIds Brevo inválidos');const testMode=Boolean(x.testMode);if(testMode&&(listIds.length!==1||listIds[0]!==116))throw new Error('Las pruebas Brevo solo pueden usar la lista 116');if(!testMode&&listIds.includes(116))throw new Error('Producción Brevo no puede usar la lista 116');return [{json:{...x,contractVersion:1,testMode,senderId,listIds,name:x.name.trim(),tag:x.tag.trim(),subject:x.subject.trim(),replyTo:x.replyTo.trim(),dataTableId:x.dataTableId.trim(),idempotencyKey:x.idempotencyKey.trim(),recipientGroup:x.recipientGroup.trim(),digestType:x.digestType.trim(),startedAt:new Date().toISOString()}}];"
      }
    },
    {
      "id": "e1e7a50c-ff34-4b43-9056-c00f567b5cc4",
      "name": "Verificar idempotencia Brevo",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        448,
