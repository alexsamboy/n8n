          "id": "brevo-shared",
          "name": "Brevo"
        }
      }
    },
    {
      "id": "97fb36ed-cfb7-40e5-88f2-e4841bffd370",
      "name": "Conservar campaña creada",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const source=$('Validar entrada Brevo').item.json;const campaignId=Number($json.id);if(!Number.isInteger(campaignId)||campaignId<1)throw new Error('Brevo no devolvió campaignId');const campaignCreatedAt=new Date().toISOString();return [{json:{...source,campaignId,campaignCreatedAt,createDurationMs:Date.now()-new Date(source.startedAt).valueOf()}}];"
      }
