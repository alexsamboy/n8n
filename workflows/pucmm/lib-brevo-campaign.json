        "operation": "rowNotExists",
        "dataTableId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.dataTableId }}"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "execution_key",
              "condition": "eq",
              "keyValue": "={{ $json.idempotencyKey }}"
            }
          ]
        }
      }
    },
