        0
      ],
      "parameters": {
        "jsCode": "const e=$json.execution||{};const w=$json.workflow||{};return [{json:{status:'failed',workflow:w.name||null,executionId:e.id||null,lastNode:e.lastNodeExecuted||null,error:String(e.error?.message||$json.error?.message||'Error').slice(0,500),timestamp:new Date().toISOString()}}];"
      }
    },
