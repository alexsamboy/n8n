            {
              "id": "alert-1",
              "name": "alertTo",
              "value": "manuelperez@pucmm.edu.do",
              "type": "string"
            },
            {
              "id": "alert-2",
              "name": "transport",
              "value": "smtp",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      }
    },
    {
